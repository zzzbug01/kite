# Copy to /etc/kite/relay.env and chmod 600.
# Replace CHANGE_ME. Never commit the filled-in file.
LISTEN_ADDR=127.0.0.1:8080
REGISTRATION_KEY=CHANGE_ME
# During rotation, keep accepting the previous agent key. Unset when every
# agent has moved to REGISTRATION_KEY. Paired clients do not use either key.
# REGISTRATION_KEY_PREVIOUS=
# Hashed per-client tokens (clients.json) and install codes / agent tokens
# (install.json). Default is /var/lib/kite. Do not commit those files.
# STATE_DIR=/var/lib/kite
# Comma-separated IPs or CIDRs that may set X-Forwarded-For. Empty trusts
# only loopback and uses the right-most address (the one the local proxy
# appended). "none" ignores the header.
# TRUSTED_PROXIES=
IDLE_TIMEOUT=90s
# Optional direct TLS. Leave unset when nginx or Caddy terminates TLS.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
