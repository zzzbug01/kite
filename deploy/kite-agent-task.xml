<?xml version="1.0" encoding="UTF-8"?>
<!--
  Task Scheduler template for kite-agent.

  It does not contain a registration key. Point the action at the wrapper
  created by install-kite-agent.ps1 (or start-kite-agent.cmd.example after you
  copy it outside the repo and fill it in). Import with:

    schtasks /Create /TN kite-agent /XML kite-agent-task.xml /F

  Do not commit a copy that has been edited to include a real key or host.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>kite-agent dial-out SSH tunnel</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <Enabled>true</Enabled>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>999</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\kite\start-kite-agent.cmd</Command>
    </Exec>
  </Actions>
</Task>
