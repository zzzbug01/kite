# Source this from a shell profile (the copy, not this example):
#   set -a; . "$HOME/.config/kite/client.env"; set +a
#
# OpenSSH does not expand variables inside ProxyCommand, so kite must inherit
# RELAY_ADDR and REGISTRATION_KEY from the environment. Never commit the copy.
RELAY_ADDR=wss://tunnel.example.com/client
REGISTRATION_KEY=CHANGE_ME
IDLE_TIMEOUT=90s
