[Unit]
Description=kite relay (SSH over WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kite-relay
EnvironmentFile=/etc/kite/relay.env
# Hashed client tokens (clients.json) and install codes / agent tokens
# (install.json). Mode is 0600. Raw secrets are not stored.
StateDirectory=kite
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
