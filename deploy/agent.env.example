# Copy to /etc/kite/agent.env (Linux) or ~/.config/kite/agent.env (macOS)
# and chmod 600. Replace every CHANGE_ME / example value.
# Never commit the filled-in file.
#
# Windows does not read this file from the service. From an elevated prompt,
# set the variables and run `kite-agent install`. That writes
# %ProgramData%\kite\config.yaml for the LocalSystem service account.
RELAY_ADDR=wss://tunnel.example.com/agent
REGISTRATION_KEY=CHANGE_ME
AGENT_NAME=my-pc
LOCAL_SSH_ADDR=127.0.0.1:22
IDLE_TIMEOUT=90s
